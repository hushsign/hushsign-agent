{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hushsign.dev/schemas/v1/gateway-heartbeat.json",
  "title": "GatewayHeartbeat",
  "description": "Agent -> platform health signal: modems, SIMs, counters and config hashes. Published on hs.fleet.heartbeat.v1, keyed by gatewayId. Data minimization: no raw IMSI/ICCID (hashes only), no full MSISDNs (masked only), no raw payloads. Enums are append-only.",
  "type": "object",
  "required": [
    "protocolVersion",
    "gatewayId",
    "version",
    "policyHash",
    "configHash",
    "sequence",
    "sentAt"
  ],
  "properties": {
    "protocolVersion": { "type": "string", "enum": ["1"] },
    "gatewayId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "policyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "uptimeSeconds": { "type": "integer", "minimum": 0 },
    "sentAt": { "type": "string", "format": "date-time" },
    "modems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["serial", "model", "manufacturer", "status"],
        "properties": {
          "serial": { "type": "string", "minLength": 1, "maxLength": 128 },
          "model": { "type": "string", "maxLength": 128 },
          "manufacturer": { "type": "string", "maxLength": 128 },
          "status": { "type": "string", "enum": ["READY", "BUSY", "DEGRADED", "ERROR"] },
          "portHint": { "type": "string", "maxLength": 255 },
          "memoryStore": { "type": "string", "maxLength": 64 },
          "signalQuality": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
        }
      }
    },
    "sims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iccidHash", "imsiHash"],
        "properties": {
          "iccidHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "imsiHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "operator": { "type": "string", "pattern": "^[0-9]{3}-[0-9]{2,3}$" },
          "label": { "type": "string", "maxLength": 128 },
          "active": { "type": "boolean" },
          "modemSerial": { "type": "string", "maxLength": 128 },
          "msisdnMasked": { "type": "string", "maxLength": 32 }
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
