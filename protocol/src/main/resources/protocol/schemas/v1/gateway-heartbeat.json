{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hushsign.dev/schemas/v1/gateway-heartbeat.json",
  "title": "GatewayHeartbeat",
  "description": "Agent -> platform health signal: modems, SIMs, counters and config hashes. Published on hs.fleet.heartbeat.v1, keyed by gatewayId. Data minimization: no raw IMSI/ICCID (hashes only), no full MSISDNs (masked only), no raw payloads. Enums are append-only.",
  "type": "object",
  "required": [
    "protocolVersion",
    "gatewayId",
    "version",
    "policyHash",
    "configHash",
    "sequence",
    "sentAt"
  ],
  "properties": {
    "protocolVersion": { "type": "string", "enum": ["1"] },
    "gatewayId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "policyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "uptimeSeconds": { "type": "integer", "minimum": 0 },
    "sentAt": { "type": "string", "format": "date-time" },
    "bootId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "supportedTechniques": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SILENT_TP0", "WAP_PUSH_EMPTY", "WAP_PUSH_SL", "WAP_PUSH_SI", "MWI_TOGGLE", "MMS_NOTIFY_EMPTY", "MWI_DEACTIVATE"]
      }
    },
    "modems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["serial", "model", "manufacturer", "status"],
        "properties": {
          "serial": { "type": "string", "minLength": 1, "maxLength": 128 },
          "model": { "type": "string", "maxLength": 128 },
          "manufacturer": { "type": "string", "maxLength": 128 },
          "status": { "type": "string", "enum": ["READY", "BUSY", "DEGRADED", "ERROR"] },
          "portHint": { "type": "string", "maxLength": 255 },
          "memoryStore": { "type": "string", "maxLength": 64 },
          "signalQuality": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
        }
      }
    },
    "sims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iccidHash", "imsiHash"],
        "properties": {
          "iccidHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "imsiHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "operator": { "type": "string", "pattern": "^[0-9]{3}-[0-9]{2,3}$" },
          "label": { "type": "string", "maxLength": 128 },
          "active": { "type": "boolean" },
          "modemSerial": { "type": "string", "maxLength": 128 },
          "msisdnMasked": { "type": "string", "maxLength": 32 }
        }
      }
    },
    "policy": {
      "description": "The rules the device is actually enforcing right now (P7-S13). The platform could previously see only policyHash, which says the file changed but not what it now says - so a refusal could not be explained from the console.",
      "type": "object",
      "required": ["killSwitch", "caps", "techniques", "operators", "source"],
      "properties": {
        "killSwitch": { "type": "boolean" },
        "caps": {
          "type": "object",
          "required": ["perTargetPerHour", "perOperatorPerHour", "perGatewayPerHour"],
          "properties": {
            "perTargetPerHour": { "type": "integer", "minimum": 0 },
            "perOperatorPerHour": { "type": "integer", "minimum": 0 },
            "perGatewayPerHour": { "type": "integer", "minimum": 0 }
          }
        },
        "techniques": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "operators": { "type": "array", "items": { "type": "string", "maxLength": 16 } },
        "quietHours": {
          "type": ["object", "null"],
          "required": ["start", "end", "zone"],
          "properties": {
            "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
            "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
            "zone": { "type": "string", "maxLength": 64 }
          }
        },
        "maxCommandAgeSeconds": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "enum": ["LOCAL", "REMOTE"] },
        "remoteAllowed": { "type": "array", "items": { "type": "string", "maxLength": 64 } }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
